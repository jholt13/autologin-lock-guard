#!/bin/zsh

# If you change your daemon file name, update the following line
launch_daemon_plist_name='com.github.jholt13.autologin-lock-guard.plist'

# Base paths
launch_daemon_base_path='Library/LaunchDaemons/'

# Load daemon if installing to a running system
if [[ $3 == "/" ]] ; then
  # Fail the install if the admin forgets to change their paths and they don't exist.
  if [ ! -e "$3${launch_daemon_base_path}${launch_daemon_plist_name}" ]; then
    echo "LaunchDaemon missing, exiting"
    exit 1
  fi

  # Unload the daemon so it can be triggered on re-install
  /bin/launchctl unload -w "$3${launch_daemon_base_path}${launch_daemon_plist_name}" 2>/dev/null
  # Load the launch daemon
  /bin/launchctl load -w "$3${launch_daemon_base_path}${launch_daemon_plist_name}"
fi

exit 0
